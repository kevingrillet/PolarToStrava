# Copier ce fichier vers `.env` (ignoré par git) et renseigner les deux premières
# valeurs. Elles proviennent de https://www.strava.com/settings/api — créer une
# application, puis relever l'identifiant et le secret client.
#
# ⚠ Dans les réglages de l'application Strava, le champ
#   « Authorization Callback Domain » doit valoir exactement :  localhost
#   (le domaine seul, sans protocole, sans port, et non 127.0.0.1)

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Port du backend. Doit rester aligné sur `API_PORT` dans vite.config.ts.
PORT=8787

# Origine de l'interface, vers laquelle on redirige après authentification.
WEB_ORIGIN=http://localhost:5173

# Dossier des données locales : jeton Strava, journal de reprise, cache de scan.
DATA_DIR=.data
